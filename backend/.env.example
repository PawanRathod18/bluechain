# Copy to backend/.env for local development.
DATABASE_URL=sqlite:///./bluechain.db
SECRET_KEY=dev-secret-change-me-in-production
ENVIRONMENT=development
STORAGE_DIR=./storage
MAX_UPLOAD_MB=200
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
BLUECHAIN_SEED=true

# carbon model defaults (project-specific, from the paper)
AGB_COEFFICIENT=10.5
CARBON_FRACTION=0.47
NDVI_THRESHOLD=0.4
GAPFILL_MULTIPLIER=15.0
NOMINAL_CELL_HA=0.01

# chain
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
